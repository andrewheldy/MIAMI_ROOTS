# Miami Roots — environment variable reference
#
# Copy this file to .env.local for local development once the application exists.
# This file must only ever contain variable NAMES and safe placeholder values —
# never real credentials. See CLAUDE.md / AGENTS.md.
#
# NEXT_PUBLIC_* variables are bundled into client-side JavaScript and are visible
# to anyone using the site. Anything without that prefix is server-only and must
# never be referenced from client components.

# --- Client-safe (NEXT_PUBLIC_*) ---------------------------------------------

# Canonical public URL of the site. Should stay stable even if underlying
# WhatsApp invite links change.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL — safe to expose, paired with the anon key below which
# is subject to row-level security policies.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous/public API key. Safe for client use only because RLS
# policies restrict what it can read/write.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Feature flag for enabling client-side analytics. "true" / "false".
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# --- Server-only (never NEXT_PUBLIC_, never sent to the browser) -------------

# Supabase service-role key. Bypasses row-level security — server-side use
# only (e.g. admin operations, background jobs). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
