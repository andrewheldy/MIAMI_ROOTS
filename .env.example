# Miami Roots — environment variable reference
#
# Copy this file to .env.local for local development once the application exists.
# This file must only ever contain variable NAMES and safe placeholder values —
# never real credentials. See CLAUDE.md / AGENTS.md.
#
# NEXT_PUBLIC_* variables are bundled into client-side JavaScript and are visible
# to anyone using the site. Anything without that prefix is server-only and must
# never be referenced from client components.

# --- Client-safe (NEXT_PUBLIC_*) ---------------------------------------------

# Canonical public URL of the site. Should stay stable even if underlying
# WhatsApp invite links change.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL — safe to expose, paired with the anon key below which
# is subject to row-level security policies.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous/public API key. Safe for client use only because RLS
# policies restrict what it can read/write.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Feature flag for enabling client-side analytics. "true" / "false".
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# --- Server-only (never NEXT_PUBLIC_, never sent to the browser) -------------

# Supabase service-role key. Bypasses row-level security — server-side use
# only (e.g. admin operations, background jobs). Never expose to the client;
# the only module allowed to read it is src/lib/supabase/service.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Per-chat WhatsApp invite URLs behind the /go/<chat> redirect routes.
# Treat these as credentials (see docs/05-operations/chat-link-management.md):
# they are read server-side per request, must be https:// URLs on an approved
# WhatsApp domain (e.g. https://chat.whatsapp.com/...), and are NEVER committed
# to this repository — rotation is a hosting-config change, not a code change.
# Leave a variable unset to show that link's polished "unavailable" state.
#
# Since 2026-08-16 no page on the site links to these; they stay configured so
# links already printed on cards or pasted into messages keep resolving.
#
# NOTE: the parent community link is NOT here. /go/community redirects to a
# build-time constant in src/content/join/community-link.ts and needs no
# environment variable at all (owner decision 2026-08-17). Setting
# WHATSAPP_COMMUNITY_URL in hosting now does nothing; it can be deleted.
WHATSAPP_GENERAL_CHAT_URL=
WHATSAPP_BUSINESS_CONNECTIONS_URL=
WHATSAPP_DAYTIME_EVENTS_URL=
WHATSAPP_NIGHTLIFE_EVENTS_URL=
WHATSAPP_TICKET_EXCHANGE_URL=
WHATSAPP_COMMUNITY_ORGANIZING_URL=
WHATSAPP_SOBER_SUPPORT_URL=

# Local/CI database harness ONLY (scripts/db/reset.sh, npm run db:test).
# Points at a disposable local Postgres, e.g.
# postgresql://postgres@localhost:55432/postgres — never at a hosted project.
# The full per-environment variable matrix is documented in
# docs/08-delivery/milestone-3-database-foundation.md.
SUPABASE_DB_URL=
